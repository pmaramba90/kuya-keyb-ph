{
  "rules": {
    "meta": {
      ".read": true,
      "userCount": {
        ".write": "auth != null && newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
      }
    },
    "users": {
      ".read": "auth != null",
      "$uid": { ".write": "auth != null && auth.uid === $uid" }
    },
    "names": {
      ".read": "auth != null",
      "$name": { ".write": "auth != null && newData.val() === auth.uid && (!data.exists() || data.val() === auth.uid)" }
    },
    "avatars": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.isString() && newData.val().beginsWith('data:image/') && newData.val().length < 300000"
      }
    },
    "profiles": {
      ".read": "auth != null",
      "$uid": { ".write": "auth != null && auth.uid === $uid" }
    },
    "private": {
      "$uid": { ".read": "auth != null && auth.uid === $uid", ".write": "auth != null && auth.uid === $uid" }
    },
    "friendReqs": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$from": {
          ".read": "auth != null && auth.uid === $from",
          ".write": "auth != null && (auth.uid === $to || auth.uid === $from)"
        }
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$other": {
          ".write": "auth != null && (auth.uid === $uid || (auth.uid === $other && (!newData.exists() || root.child('friendReqs').child($other).child($uid).exists())))"
        }
      }
    },
    "builds": {
      ".read": "auth != null",
      "$uid": { ".write": "auth != null && auth.uid === $uid" }
    },
    "presence": {
      ".read": "auth != null",
      "$uid": { ".write": "auth != null && auth.uid === $uid" }
    },
    "challenges": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$from": {
          ".read": "auth != null && auth.uid === $from",
          ".write": "auth != null && (auth.uid === $to || auth.uid === $from)"
        }
      }
    },
    "matches": {
      "$mid": {
        ".read": "auth != null && (data.child('a').val() === auth.uid || data.child('b').val() === auth.uid)",
        ".write": "auth != null && (data.exists() ? (data.child('a').val() === auth.uid || data.child('b').val() === auth.uid) : (newData.child('a').val() === auth.uid || newData.child('b').val() === auth.uid))"
      }
    }
  }
}
