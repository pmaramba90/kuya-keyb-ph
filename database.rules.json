{
  "rules": {
    "meta": {
      ".read": true,
      "userCount": {
        ".write": "auth != null && newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
      }
    },
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "name": { ".validate": "auth.token.email === newData.val() + '@players.kuyakeybph.com'" },
        "display": { ".validate": "newData.isString() && newData.val().toLowerCase() === newData.parent().child('name').val()" },
        "created": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },
    "names": {
      ".read": "auth != null",
      "$name": { ".write": "auth != null && auth.token.email === $name + '@players.kuyakeybph.com' && (newData.val() === auth.uid || !newData.exists())" }
    },
    "avatars": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.isString() && newData.val().length < 300000 && newData.val().matches(/^data:image\\/(jpeg|png|webp);base64,[A-Za-z0-9+\\/=]+$/)"
      }
    },
    "profiles": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "nickname": { ".validate": "newData.isString() && newData.val().length <= 30" },
        "city": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "country": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "$other": { ".validate": false }
      }
    },
    "private": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "email": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "$other": { ".validate": false }
      }
    },
    "friendReqs": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$from": {
          ".read": "auth != null && auth.uid === $from",
          ".write": "auth != null && (auth.uid === $from || (auth.uid === $to && !newData.exists()))",
          "name": { ".validate": "auth.token.email === newData.val() + '@players.kuyakeybph.com'" },
          "display": { ".validate": "newData.isString() && newData.val().toLowerCase() === newData.parent().child('name').val()" }
        }
      }
    },
    "sentReqs": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$to": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['name', 'at'])",
          "name": { ".validate": "newData.isString() && newData.val().length <= 30" },
          "at": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$other": {
          ".write": "auth != null && (auth.uid === $uid || (auth.uid === $other && (!newData.exists() || root.child('friendReqs').child($other).child($uid).exists())))",
          ".validate": "newData.isNumber()"
        }
      }
    },
    "builds": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "$pid": {
          "w": { ".validate": "newData.isNumber()" },
          "l": { ".validate": "newData.isNumber()" }
        }
      }
    },
    "hearts": {
      ".read": "auth != null",
      "$owner": {
        "$pid": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && $uid !== $owner",
            ".validate": "newData.val() === true"
          }
        }
      }
    },
    "posts": {
      ".read": "auth != null",
      "$uid": {
        "$id": {
          ".write": "auth != null && (auth.uid === $uid || ((auth.token.email === 'akosipolnew1@players.kuyakeybph.com' || auth.token.email === 'kuyakeybph@players.kuyakeybph.com') && !newData.exists()))",
          ".validate": "newData.hasChildren(['type', 'at']) && (newData.child('type').val() === 'post' || (newData.child('type').val() === 'review' && newData.hasChildren(['kind', 'item', 'rating'])) || (newData.child('type').val() === 'activity' && newData.hasChildren(['act'])))",
          "link": { ".validate": "newData.isString() && newData.val().length <= 500 && newData.val().beginsWith('https://')" },
          "gif": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9]{4,64}$/)" },
          "type": { ".validate": "newData.val() === 'post' || newData.val() === 'review' || newData.val() === 'activity'" },
          "act": { ".validate": "newData.val() === 'build' || newData.val() === 'win' || newData.val() === 'level' || newData.val() === 'best' || newData.val() === 'heart' || newData.val() === 'top'" },
          "photo": { ".validate": "newData.isString() && newData.val().length < 400000 && newData.val().matches(/^data:image\\/jpeg;base64,[A-Za-z0-9+\\/=]+$/)" },
          "kb": {
            ".validate": "newData.hasChildren(['name', 'build'])",
            "name": { ".validate": "newData.isString() && newData.val().length <= 60" },
            "pid": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "build": { ".validate": "newData.hasChildren(['layout', 'case', 'switch', 'keycap'])" },
            "$other": { ".validate": false }
          },
          "opp": { ".validate": "newData.isString() && newData.val().length <= 128" },
          "oppName": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "score": { ".validate": "newData.isString() && newData.val().length <= 12" },
          "level": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000" },
          "rank": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 3" },
          "total": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "owner": { ".validate": "newData.isString() && newData.val().length <= 128" },
          "oname": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "text": { ".validate": "newData.isString() && newData.val().length <= 1000" },
          "at": { ".validate": "newData.isNumber()" },
          "kind": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "item": { ".validate": "newData.isString() && newData.val().length <= 200" },
          "rating": { ".validate": "newData.isNumber() && newData.val() >= 0.5 && newData.val() <= 5 && (newData.val() * 2) % 1 === 0" },
          "$other": { ".validate": false }
        }
      }
    },
    "reacts": {
      ".read": "auth != null",
      "$owner": {
        "$pid": {
          ".write": "auth != null && !newData.exists() && (auth.uid === $owner || (auth.token.email === 'akosipolnew1@players.kuyakeybph.com' || auth.token.email === 'kuyakeybph@players.kuyakeybph.com'))",
          "$kind": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && ($kind === 'heart' || $kind === 'laugh' || $kind === 'fire' || $kind === 'cream') && (!newData.exists() || root.child('posts').child($owner).child($pid).exists())",
              ".validate": "newData.val() === true"
            }
          }
        }
      }
    },
    "replies": {
      ".read": "auth != null",
      "$owner": {
        "$pid": {
          ".write": "auth != null && !newData.exists() && (auth.uid === $owner || (auth.token.email === 'akosipolnew1@players.kuyakeybph.com' || auth.token.email === 'kuyakeybph@players.kuyakeybph.com'))",
          "$rid": {
            ".write": "auth != null && (newData.exists() ? !data.exists() && newData.child('uid').val() === auth.uid && root.child('posts').child($owner).child($pid).exists() : (data.child('uid').val() === auth.uid || auth.uid === $owner || (auth.token.email === 'akosipolnew1@players.kuyakeybph.com' || auth.token.email === 'kuyakeybph@players.kuyakeybph.com')))",
            ".validate": "newData.hasChildren(['uid', 'text', 'at'])",
            "uid": { ".validate": "newData.isString()" },
            "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500" },
            "at": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        }
      }
    },
    "notifs": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$nid": {
          ".write": "auth != null && (auth.uid === $uid ? !newData.exists() : (newData.exists() ? newData.child('from').val() === auth.uid && (!data.exists() || data.child('from').val() === auth.uid) : data.child('from').val() === auth.uid))",
          ".validate": "newData.hasChildren(['t', 'from', 'at'])",
          "t": { ".validate": "newData.val() === 'react' || newData.val() === 'reply' || newData.val() === 'heart' || newData.val() === 'challenge' || newData.val() === 'friend'" },
          "from": { ".validate": "newData.isString() && newData.val().length <= 128" },
          "at": { ".validate": "newData.isNumber()" },
          "post": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "kind": { ".validate": "newData.isString() && newData.val().length <= 10" },
          "text": { ".validate": "newData.isString() && newData.val().length <= 80" },
          "pid": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "name": { ".validate": "newData.isString() && newData.val().length <= 60" },
          "$other": { ".validate": false }
        }
      }
    },
    "notifSeen": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.isNumber()"
      }
    },
    "stats": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['week', 'solo', 'wins'])",
        "week": { ".validate": "newData.isString() && newData.val().length <= 10" },
        "solo": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "wins": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "$other": { ".validate": false }
      }
    },
    "history": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$id": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['opp', 'won', 'at'])",
          "opp": { ".validate": "newData.isString() && newData.val().length <= 128" },
          "oppName": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "won": { ".validate": "newData.isBoolean()" },
          "score": { ".validate": "newData.isString() && newData.val().length <= 12" },
          "how": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "build": { ".validate": "newData.isString() && newData.val().length <= 60" },
          "at": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    },
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "name": { ".validate": "auth.token.email === newData.val() + '@players.kuyakeybph.com'" },
        "display": { ".validate": "newData.isString() && newData.val().toLowerCase() === newData.parent().child('name').val()" }
      }
    },
    "challenges": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$from": {
          ".read": "auth != null && auth.uid === $from",
          ".write": "auth != null && (auth.uid === $from || (auth.uid === $to && data.exists()))",
          "fromName": { ".validate": "newData.val() === data.val() || auth.token.email === newData.val().toLowerCase() + '@players.kuyakeybph.com'" }
        }
      }
    },
    "matches": {
      "$mid": {
        ".read": "auth != null && (data.child('a').val() === auth.uid || data.child('b').val() === auth.uid)",
        ".write": "auth != null && (data.exists() ? (data.child('a').val() === auth.uid || data.child('b').val() === auth.uid) : (newData.child('a').val() === auth.uid || newData.child('b').val() === auth.uid))"
      }
    }
  }
}
